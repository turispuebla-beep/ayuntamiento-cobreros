{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "warn",
    "no-undef": "error",
    "semi": ["error", "always"],
    "quotes": ["error", "single"],
    "indent": ["warn", 2],
    "no-var": "error",
    "prefer-const": "warn"
  },
  "globals": {
    "firebase": "readonly",
    "Logger": "readonly",
    "showNotification": "readonly",
    "isAdmin": "readonly",
    "isSuperAdmin": "readonly",
    "currentUser": "readonly"
  }
}

