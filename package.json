{
  "name": "ayuntamiento-cobreros",
  "version": "2.3.0",
  "description": "Sistema completo de gestión municipal para el Ayuntamiento de Cobreros",
  "main": "index.html",
  "scripts": {
    "start": "npx http-server . -p 8080 -c-1",
    "build": "npm run minify:js && npm run minify:css",
    "minify:js": "npx terser js/script.js -o js/script.min.js -c -m --comments false",
    "minify:css": "npx csso css/styles.css -o css/styles.min.css",
    "lint": "npx eslint js/**/*.js --fix",
    "test": "npx jest --passWithNoTests",
    "test:watch": "npx jest --watch",
    "snapshot": "node tools/create-snapshot.js",
    "snapshot:restore": "node tools/restore-snapshot.js",
    "deploy:firestore": "firebase deploy --only firestore:rules",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:all": "firebase deploy",
    "analyze": "npx bundlesize"
  },
  "keywords": [
    "ayuntamiento",
    "municipal",
    "pwa",
    "firebase",
    "notificaciones"
  ],
  "author": "TURISTEAM",
  "license": "PRIVATE",
  "repository": {
    "type": "git",
    "url": "."
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "terser": "^5.24.0",
    "csso-cli": "^4.0.2",
    "eslint": "^8.55.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "fs-extra": "^11.1.1"
  },
  "bundlesize": [
    {
      "path": "./js/script.js",
      "maxSize": "500 KB"
    },
    {
      "path": "./css/styles.css",
      "maxSize": "200 KB"
    }
  ]
}

